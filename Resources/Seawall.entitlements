<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks Apple Events unless this is set. BrowserGuard reads and
	     redirects browser tabs through NSAppleScript, so a Developer ID build needs it.
	     Not sandboxed on purpose: no com.apple.security.app-sandbox. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
